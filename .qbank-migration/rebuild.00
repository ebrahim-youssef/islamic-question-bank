from pathlib import Path
import re,json,collections,unicodedata,hashlib,sys
BASE=Path('/mnt/data/qbank_rebuild')
OUT=Path('/mnt/data/qbank_final')
PILLARS=['hajj','salah','sawm','shahada','zakah']
AGE={'Kids':'kids','General':'general','Scholar':'scholar'}
QID_PREFIX={'hajj':'haj','salah':'sal','sawm':'saw','shahada':'sha','zakah':'zak'}
TAG={'hajj':'الحج','salah':'الصلاة','sawm':'الصيام','shahada':'الشهادة','zakah':'الزكاة'}

def field(block,name):
 m=re.search(rf'\*\*{re.escape(name)}:\*\*\s*(.+)',block)
 return m.group(1).strip() if m else None

def parse():
 out=[]
 for key in PILLARS:
  lines=(BASE/f'{key}_75_final_verified.md').read_text('utf-8').splitlines()
  audience=tier=None; seq=collections.Counter(); i=0
  while i<len(lines):
   m=re.match(r'##\s+(Kids|General|Scholar).*Tier\s+(\d+)',lines[i])
   if m: audience=AGE[m.group(1)]; tier=int(m.group(2)); i+=1; continue
   if not re.match(r'###\s+Q\d+',lines[i]): i+=1; continue
   start=i; i+=1
   while i<len(lines) and not re.match(r'###\s+Q\d+',lines[i]) and not lines[i].startswith('## '): i+=1
   block='\n'.join(lines[start:i])
   choices=[]
   cm=re.search(r'\*\*الاختيارات:\*\*\n(.*?)(?=\n\*\*الإجابة الصحيحة:)',block,re.S)
   for line in (cm.group(1).splitlines() if cm else []):
    m2=re.match(r'-\s*([A-D])\.\s*(.*?)(?:\s*✅)?$',line.strip())
    if m2: choices.append({'id':m2.group(1).lower(),'text':re.sub(r'\s*✅\s*$','',m2.group(2)).strip()})
   ans=field(block,'الإجابة الصحيحة'); am=re.match(r'([A-D])\.\s*(.*)',ans or '')
   evm=re.search(r'\*\*(نص الدليل القرآني|نص الدليل من السنة|وجه الدلالة من السنة):\*\*\s*(.+)',block)
   rm=re.search(r'\*\*المراجع:\*\*\n(.*?)(?=\n\*\*التحقق:)',block,re.S)
   refs=[re.sub(r'^-\s*','',x.strip()) for x in (rm.group(1).splitlines() if rm else []) if x.strip().startswith('-')]
   seq[(audience,tier)]+=1; n=seq[(audience,tier)]
   out.append({'id':f"{QID_PREFIX[key]}-{audience[0]}{tier}-{n:02d}",'categoryId':key,'ageBand':audience,'tier':tier,
    'text':field(block,'السؤال'),'choices':choices,'correctChoiceId':am.group(1).lower() if am else None,'explanation':field(block,'الشرح'),
    'rawEvidenceLabel':evm.group(1) if evm else None,'rawEvidence':evm.group(2).strip() if evm else None,'rawReferences':refs,'tags':[TAG[key]]})
 return out

data=parse()

H={}
H.update({
'haj-k2-02':'إن النبي صلى الله عليه وسلم وقت لأهل المدينة ذا الحليفة، ولأهل الشام الجحفة، ولأهل نجد قرن المنازل، ولأهل اليمن يلملم.','haj-k3-01':'إذا استلم الركن الأسود أول ما يطوف يخب ثلاثة أطواف من السبع.','haj-k3-05':'اللهم ارحم المحلقين. قالوا: والمقصرين يا رسول الله؟ قال: اللهم ارحم المحلقين. قالوا: والمقصرين يا رسول الله؟ قال: والمقصرين.','haj-k4-02':'افعلي كما يفعل الحاج غير أن لا تطوفي بالبيت حتى تطهري.','haj-k4-03':'والحج المبرور ليس له جزاء إلا الجنة.','haj-k4-04':'العمرة إلى العمرة كفارة لما بينهما.','haj-k5-01':'أمر الناس أن يكون آخر عهدهم بالبيت، إلا أنه خفف عن الحائض.','haj-k5-03':'فلما كان يوم التروية توجهوا إلى منى فأهلوا بالحج.','haj-k5-04':'وأشار بيده اليمنى: أيها الناس، السكينة السكينة.','haj-g1-01':'إن النبي صلى الله عليه وسلم وقت لأهل المدينة ذا الحليفة، ولأهل الشام الجحفة، ولأهل نجد قرن المنازل، ولأهل اليمن يلملم.','haj-g2-01':'لا يلبس القمص ولا العمائم ولا السراويلات ولا البرانس ولا الخفاف.','haj-g2-02':'ولا تلبسوا من الثياب شيئا مسه الزعفران أو ورس.','haj-g4-05':'سقيت رسول الله صلى الله عليه وسلم من زمزم فشرب وهو قائم.','haj-g5-01':'قدم رسول الله صلى الله عليه وسلم وأصحابه فقال المشركون: إنه يقدم عليكم وقد وهنتهم حمى يثرب. فأمرهم النبي صلى الله عليه وسلم أن يرملوا الأشواط الثلاثة.','haj-g5-02':'كان قريش ومن دان دينها يقفون بالمزدلفة، وكانوا يسمون الحمس، وكان سائر العرب يقفون بعرفة.','haj-g5-03':'أرسلني مع عبد الرحمن إلى التنعيم فاعتمرت، فقال صلى الله عليه وسلم: هذه مكان عمرتك.','haj-g5-04':'من كان معه هدي فليهل بالحج والعمرة ثم لا يحل حتى يحل منهما.','haj-s3-03':'فقدم مكة لأربع ليال خلون من ذي الحجة، فطاف بالبيت وسعى بين الصفا والمروة، ولم يحل من أجل بدنه لأنه قلدها.','haj-s3-04':'وإنما أنزلت هذه الآية في الأنصار، كانوا يهلون لمناة التي كانوا يعبدونها عند المشلل.','haj-s3-05':'فأذن بلال، ثم أقام فصلى الظهر، ثم أقام فصلى العصر، ولم يصل بينهما شيئا.','haj-s4-01':'فصلى بها المغرب والعشاء بأذان واحد وإقامتين، ولم يسبح بينهما شيئا.','haj-s4-03':'اشتركنا مع النبي صلى الله عليه وسلم في الحج والعمرة كل سبعة في بدنة.','haj-s4-05':'ثم نفذ إلى مقام إبراهيم عليه السلام، فقرأ: واتخذوا من مقام إبراهيم مصلى. فجعل المقام بينه وبين البيت.','haj-s5-01':'فلما كان يوم التروية توجهوا إلى منى فأهلوا بالحج.','haj-s5-02':'فلم يزل واقفا حتى غربت الشمس، وذهبت الصفرة قليلا، حتى غاب القرص.','haj-s5-03':'فلم يزل واقفا حتى أسفر جدا، فدفع قبل أن تطلع الشمس.','haj-s5-04':'وربا الجاهلية موضوع، وأول ربا أضع ربا عباس بن عبد المطلب، فإنه موضوع كله.','haj-s5-05':'إن دماءكم وأموالكم حرام عليكم كحرمة يومكم هذا، في شهركم هذا، في بلدكم هذا.'})
H.update({
'sal-k1-01':'خمس صلوات في اليوم والليلة.','sal-k1-03':'إذا قمت إلى الصلاة فكبر، ثم اقرأ ما تيسر معك من القرآن، ثم اركع حتى تطمئن راكعا.','sal-k1-04':'أمرت أن أسجد على سبعة أعظم: على الجبهة - وأشار بيده على أنفه - واليدين والركبتين وأطراف القدمين.','sal-k2-02':'إذا حضرت الصلاة فليؤذن لكم أحدكم، وليؤمكم أكبركم.','sal-k2-04':'إنما جعل الإمام ليؤتم به.','sal-k2-05':'سووا صفوفكم، فإن تسوية الصفوف من إقامة الصلاة.','sal-k3-04':'إذا سمعتم الإقامة فامشوا إلى الصلاة وعليكم السكينة والوقار، ولا تسرعوا، فما أدركتم فصلوا وما فاتكم فأتموا.','sal-k3-05':'إذا دخل أحدكم المسجد فلا يجلس حتى يصلي ركعتين.','sal-k4-01':'تجتمع ملائكة الليل وملائكة النهار في صلاة الفجر.','sal-k4-02':'أثقل الصلاة على المنافقين صلاة العشاء وصلاة الفجر.','sal-k4-03':'من صلى البردين دخل الجنة.','sal-k4-04':'أرأيتم لو أن نهرا بباب أحدكم يغتسل فيه كل يوم خمسا، هل يبقى من درنه شيء؟ ... فذلك مثل الصلوات الخمس، يمحو الله بهن الخطايا.','sal-k4-05':'والملائكة يصلون على أحدكم ما دام في مصلاه الذي صلى فيه، يقولون: اللهم اغفر له، اللهم ارحمه، ما لم يحدث.','sal-k5-01':'أمرت أن أسجد على سبعة أعظم.','sal-k5-02':'إذا سمعتم النداء فقولوا مثل ما يقول المؤذن.','sal-k5-03':'لو يعلم الناس ما في النداء والصف الأول، ثم لم يجدوا إلا أن يستهموا عليه لاستهموا.','sal-k5-04':'ركعتا الفجر خير من الدنيا وما فيها.','sal-g1-01':'والصلاة نور.','sal-g2-01':'أقرب ما يكون العبد من ربه وهو ساجد، فأكثروا الدعاء.','sal-g2-02':'أي العمل أحب إلى الله؟ قال: الصلاة على وقتها.','sal-g2-03':'من نسي صلاة فليصل إذا ذكرها، لا كفارة لها إلا ذلك.','sal-g2-04':'لا تقبل صلاة بغير طهور.','sal-g2-05':'وجعلت لي الأرض مسجدا وطهورا، فأيما رجل من أمتي أدركته الصلاة فليصل.','sal-g3-01':'صلاة الجماعة تفضل صلاة الفذ بسبع وعشرين درجة.','sal-g3-02':'وصلوا كما رأيتموني أصلي.','sal-g3-03':'ما من عبد مسلم يصلي لله كل يوم ثنتي عشرة ركعة تطوعا غير فريضة، إلا بنى الله له بيتا في الجنة.','sal-g3-04':'من قام رمضان إيمانا واحتسابا غفر له ما تقدم من ذنبه.','sal-g3-05':'فإذا توضأ فأحسن الوضوء، ثم خرج إلى المسجد لا يخرجه إلا الصلاة، لم يخط خطوة إلا رفعت له بها درجة وحط عنه بها خطيئة.','sal-g4-01':'وأفضل الصلاة بعد الفريضة صلاة الليل.','sal-g4-02':'وإذا قال: سمع الله لمن حمده، فقولوا: ربنا ولك الحمد.','sal-g4-03':'فما أدركتم فصلوا وما فاتكم فأتموا.','sal-g4-05':'ولا يزال في صلاة ما انتظر الصلاة.','sal-g5-01':'لا صلاة بعد الصبح حتى ترتفع الشمس، ولا صلاة بعد العصر حتى تغيب الشمس.','sal-g5-02':'إذا قال الإمام: غير المغضوب عليهم ولا الضالين، فقولوا: آمين، فمن وافق قوله قول الملائكة غفر له ما تقدم من ذنبه.','sal-g5-03':'صلاة الليل مثنى مثنى، فإذا خشي أحدكم الصبح صلى ركعة واحدة توتر له ما قد صلى.','sal-g5-04':'صلاة في مسجدي هذا خير من ألف صلاة فيما سواه إلا المسجد الحرام.','sal-g5-05':'عليك بكثرة السجود لله، فإنك لا تسجد لله سجدة إلا رفعك الله بها درجة وحط عنك بها خطيئة.','sal-s1-01':'ثم قال: حي على الصلاة، قال: لا حول ولا قوة إلا بالله. ثم قال: حي على الفلاح، قال: لا حول ولا قوة إلا بالله.','sal-s1-02':'بين كل أذانين صلاة، بين كل أذانين صلاة، ثم قال في الثالثة: لمن شاء.','sal-s1-03':'إذا سمعتم المؤذن فقولوا مثل ما يقول، ثم صلوا علي، فإنه من صلى علي صلاة صلى الله عليه بها عشرا، ثم سلوا الله لي الوسيلة.','sal-s1-04':'من قال حين يسمع النداء: اللهم رب هذه الدعوة التامة والصلاة القائمة، آت محمدا الوسيلة والفضيلة، وابعثه مقاما محمودا الذي وعدته، حلت له شفاعتي يوم القيامة.','sal-s1-05':'أمر بلال أن يشفع الأذان، وأن يوتر الإقامة.','sal-s2-01':'ذكروا للنبي صلى الله عليه وسلم أنهم كانوا يؤذنون بالبوق، وذكروا الناقوس.','sal-s2-02':'فإذا خرج الإمام طووا صحفهم ويستمعون الذكر.','sal-s2-03':'فيه ساعة لا يوافقها عبد مسلم وهو قائم يصلي يسأل الله تعالى شيئا إلا أعطاه إياه.','sal-s2-04':'إذا قلت لصاحبك يوم الجمعة: أنصت، والإمام يخطب، فقد لغوت.','sal-s2-05':'من أدرك ركعة من الصلاة فقد أدرك الصلاة.','sal-s3-01':'كان النبي صلى الله عليه وسلم يقرأ في الجمعة في صلاة الفجر: الم تنزيل السجدة، وهل أتى على الإنسان.','sal-s3-03':'قرأ في ركعتي الفجر: قل يا أيها الكافرون، وقل هو الله أحد.','sal-s3-04':'كان رسول الله صلى الله عليه وسلم يقول في ركوعه وسجوده: سبوح قدوس رب الملائكة والروح.','sal-s3-05':'إن الشمس والقمر لا ينكسفان لموت أحد ولا لحياته، ولكنهما آيتان من آيات الله، فإذا رأيتموهما فصلوا.','sal-s4-01':'خير صفوف الرجال أولها وشرها آخرها، وخير صفوف النساء آخرها وشرها أولها.','sal-s4-02':'من راح في الساعة الأولى فكأنما قرب بدنة، ومن راح في الساعة الثانية فكأنما قرب بقرة، ومن راح في الساعة الثالثة فكأنما قرب كبشا أقرن، ومن راح في الساعة الرابعة فكأنما قرب دجاجة، ومن راح في الساعة الخامسة فكأنما قرب بيضة.','sal-s4-03':'من أدرك ركعة من الصبح قبل أن تطلع الشمس فقد أدرك الصبح، ومن أدرك ركعة من العصر قبل أن تغرب الشمس فقد أدرك العصر.','sal-s4-04':'لا تشد