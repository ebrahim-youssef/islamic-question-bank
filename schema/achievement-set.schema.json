{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "islamic-question-bank/schema/achievement-set.schema.json",
  "title": "مجموعة إنجاز",
  "type": "object",
  "required": ["id", "name", "description", "questionIds"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "description": {
      "type": "string"
    },
    "questionIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
