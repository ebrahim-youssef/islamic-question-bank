{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "islamic-question-bank/schema/manifest.schema.json",
  "title": "بيان محتوى بنك الأسئلة",
  "type": "object",
  "required": [
    "schemaVersion",
    "bankHash",
    "totalQuestions",
    "totalBytes",
    "categories",
    "questionFiles",
    "achievementSets"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 3 },
    "bankHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "totalQuestions": {
      "type": "integer",
      "minimum": 0
    },
    "totalBytes": {
      "type": "integer",
      "minimum": 0
    },
    "categories": {
      "type": "object",
      "required": ["path", "sha256", "bytes"],
      "additionalProperties": false,
      "properties": {
        "path": { "const": "data/categories.json" },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "questionFiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "categoryId",
          "path",
          "sha256",
          "bytes",
          "questionCount"
        ],
        "additionalProperties": false,
        "properties": {
          "categoryId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
          },
          "path": {
            "type": "string",
            "pattern": "^data/questions/[a-z][a-z0-9]*(-[a-z0-9]+)*\\.json$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "questionCount": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "achievementSets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "bytes", "questionCount"],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^data/achievement-sets/[a-z][a-z0-9]*(-[a-z0-9]+)*\\.json$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "questionCount": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
