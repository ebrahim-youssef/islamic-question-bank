{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "islamic-question-bank/schema/question.schema.json",
  "title": "سؤال V2",
  "type": "object",
  "required": [
    "id",
    "categoryId",
    "ageBand",
    "tier",
    "text",
    "choices",
    "correctChoiceId",
    "explanation",
    "references",
    "tags",
    "verification"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "categoryId": {
      "type": "string",
      "minLength": 1
    },
    "ageBand": {
      "enum": ["kids", "general", "scholar"]
    },
    "tier": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "choices": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-d]$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "uniqueItems": true
    },
    "correctChoiceId": {
      "type": "string",
      "pattern": "^[a-d]$"
    },
    "explanation": {
      "type": "string",
      "minLength": 1
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type"],
        "additionalProperties": false,
        "oneOf": [
          {
            "type": "quran",
            "required": ["type", "surah", "ayah"],
            "properties": {
              "type": { "const": "quran" },
              "surah": { "type": "integer", "minimum": 1, "maximum": 114 },
              "ayah": { "type": "integer", "minimum": 1 }
            }
          },
          {
            "type": "hadith",
            "required": ["type", "collection", "number"],
            "properties": {
              "type": { "const": "hadith" },
              "collection": { "type": "string", "minLength": 1 },
              "number": { "type": "string", "minLength": 1 }
            }
          },
          {
            "type": "book",
            "required": ["type", "title"],
            "properties": {
              "type": { "const": "book" },
              "title": { "type": "string", "minLength": 1 },
              "locator": { "type": "string" }
            }
          },
          {
            "type": "other",
            "required": ["type", "label"],
            "properties": {
              "type": { "const": "other" },
              "label": { "type": "string", "minLength": 1 }
            }
          }
        ]
      }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "verification": {
      "type": "object",
      "required": ["status", "verifiedAt"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": ["pending", "verified", "needs_review"]
        },
        "verifiedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    }
  }
}